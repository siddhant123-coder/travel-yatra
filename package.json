{
  "name": "travel-yatra",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "concurrently \"npm run server:dev\" \"npm run dev\"",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "npm --prefix server start",
    "dev:full": "concurrently \"npm run server:dev\" \"npm run dev\"",
    "server:dev": "npm --prefix server run dev",
    "studio": "npm --prefix server run prisma:studio"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "@react-oauth/google": "^0.12.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.14",
    "concurrently": "^9.1.2"
  }
}
